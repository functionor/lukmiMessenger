# Environment mode: development, test, or production
ENV=development
PORT=8080

# Central Lukmi Database Runtime Role Credentials
APP_DATABASE_URL=postgres://lukmi_app:lukmi_app@localhost:5432/lukmi?sslmode=disable

# Transient Presence and Connection Tracking Cache
REDIS_URL=redis://localhost:6379
ALLOW_DEGRADED_REDIS=false

# Asynchronous Message Domain Event Publishing
REDPANDA_BROKERS=localhost:9092
KAFKA_TOPIC=messaging.events
KAFKA_GROUP_ID=messaging-service-group

# Authentication Contracts (MUST be explicitly configured in production)
# JWT_SECRET must be at least 32 characters in production
JWT_SECRET=development-only-jwt-secret-key-32bytes-min
JWT_ISSUER=lukmi-auth
JWT_AUDIENCE=lukmi-messaging

# GATEWAY_SECRET must be at least 16 characters in production
GATEWAY_SECRET=development-only-gateway-secret-16bytes

# Allowed origins for WebSocket connections (comma-separated, required in production)
ALLOWED_ORIGINS=https://app.lukmi.com

# HTTP Server Timeouts
READ_TIMEOUT_SECONDS=15
WRITE_TIMEOUT_SECONDS=15
IDLE_TIMEOUT_SECONDS=60
SHUTDOWN_TIMEOUT_SECONDS=10

# Database Connection Pool Settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=15
