ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lukmi?sslmode=disable
REDIS_URL=redis://localhost:6379
REDPANDA_BROKERS=localhost:9092
KAFKA_TOPIC=messaging.events
KAFKA_GROUP_ID=messaging-service-group
JWT_SECRET=lukmi-secret-key-change-in-production
READ_TIMEOUT_SECONDS=15
WRITE_TIMEOUT_SECONDS=15
IDLE_TIMEOUT_SECONDS=60
SHUTDOWN_TIMEOUT_SECONDS=10
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=15
